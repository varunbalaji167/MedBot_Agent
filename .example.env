HUGGINGFACE_HUB_TOKEN=hf_your_token_here

# Optional. Defaults to openai/gpt-oss-20b:fastest if unset. Before trusting
# any default here, verify what's actually live for a candidate model:
#   curl -s "https://huggingface.co/api/models/<MODEL_ID>?expand[]=inferenceProviderMapping"
# Look for a provider entry with "status": "live" -- a model can be listed
# on a provider's page while only being available via a paid dedicated
# endpoint, not the free serverless route (this happened during testing
# with Qwen2.5-7B-Instruct, whose only mapped provider required one).
# Only used when HUGGINGFACE_HUB_TOKEN is set above; otherwise the app falls
# back to a local flan-t5-large model automatically (no token required to run).
HF_GENERATION_MODEL=openai/gpt-oss-20b:fastest
 
# Optional, off by default. Set to 1 to show internal debug expanders in the
# sidebar (HF API failure details, raw model output behind "not covered"
# answers). Useful while developing; leave unset for anyone else running
# this, since those expanders show internal error text and prompt/response
# content that isn't meant for an end user.
MEDIBOT_DEBUG=0