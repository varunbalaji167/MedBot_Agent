# ── Generation backend: any OpenAI-compatible chat-completions endpoint ──
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=gsk_your_groq_key
LLM_MODEL=openai/gpt-oss-20b

# Free provider recipes (uncomment ONE, replace the three lines above):

# OpenRouter — many ":free" models (free key at openrouter.ai):
# LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_API_KEY=sk-or-your_key
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Google Gemini — generous free tier (key at aistudio.google.com):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# LLM_API_KEY=your_gemini_key
# LLM_MODEL=gemini-2.0-flash
#
# Ollama — fully local, no account (`ollama pull llama3.1:8b`):
# LLM_BASE_URL=http://localhost:11434/v1/chat/completions
# LLM_API_KEY=ollama                         # any non-empty string
# LLM_MODEL=llama3.1:8b

# Backward-compatible fallbacks (used only if LLM_API_KEY / LLM_MODEL are unset):
# HUGGINGFACE_HUB_TOKEN=hf_your_token_here
# HF_GENERATION_MODEL=openai/gpt-oss-20b

# Optional, off by default. Set to 1 to show internal debug expanders in the
# sidebar (API failure details, raw model output behind "not covered" answers).
MEDIBOT_DEBUG=0
